{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Flareite",
  "identifier": "dev.flareite.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Flareite",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "backgroundColor": "#1b1d21"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src flareite-webview: http://flareite-webview.localhost",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src flareite-webview: http://flareite-webview.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDRDZCOUFFQzVBRjYyM0QKUldROVlxL0Zycm5XakRuMzZiZ211YnNvak9zVmdUc2tzZ3lIbnB1NTdZbU1aZ1JzTHc3QXY3ZUUK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
