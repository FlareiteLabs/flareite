/// The Flareite extension API, version 1 (1.1: workbench contributions;
/// 1.2: previews; 1.3: files; 1.4: viewers; 1.5: webviews and storage;
/// 1.6: workspace, processes, and explorer marks; 1.7: tree views,
/// prompts, deleting files, and opening files; 1.8: provided documents
/// and diffs; 1.9: quick diff; 1.10: timers; 1.11: graphs, folders, and
/// the active file; 1.12: code lenses and merge editors; 1.13: line
/// annotations, selection changes, and hiding views; 1.14: rendering
/// Markdown; 1.15: layouts, saving documents, link handlers, and web
/// pages in tabs; 1.16: schemas, and configuring language servers; 1.17:
/// program output as it's written, password prompts, downloads, secrets,
/// and opening files with other apps; 1.18: documents for schemas, and
/// completion and hover; 1.19: text inserted as trigger characters are
/// typed).
///
/// An extension is a WebAssembly component targeting the `extension` world.
/// It can call only the functions it imports here; there is no other
/// filesystem, network, environment, clock, or process access. See
/// `docs/extensions.md`.
package flareite:extension@1.19.0;

/// Types shared by the host functions and the extension's exports.
interface types {
  /// Identifies an open document. Never reused while the editor runs.
  type document-id = u64;

  /// A place in a document: a zero-based line, and a column counted in
  /// UTF-8 bytes from the start of that line.
  record position {
    line: u32,
    column: u32,
  }

  /// The text from `start` up to (not including) `end`.
  record range {
    start: position,
    end: position,
  }

  record document-info {
    id: document-id,
    /// Increases with every change to the text.
    version: u64,
    /// The file the document was opened from or saved to.
    path: option<string>,
    /// A language identifier such as `rust`, `typescript`, or `python`.
    language: option<string>,
    line-count: u32,
    /// Length in UTF-8 bytes.
    length: u64,
    /// Whether it has unsaved changes.
    dirty: bool,
  }

  /// Text read from a document, with the version it was read at.
  record text-slice {
    version: u64,
    text: string,
  }

  /// Lines read from a document, with the version they were read at.
  record line-slice {
    version: u64,
    /// The lines, without their line breaks.
    lines: list<string>,
  }

  /// `range`, in the text before this change, was replaced by `text`.
  record text-change {
    range: range,
    text: string,
  }

  record document-change {
    document: document-id,
    /// The version after the changes.
    version: u64,
    /// The changes since the previous notification, in order: each one
    /// applies to the text left by the one before. `none` when they were
    /// too large to send; read the document again.
    changes: option<list<text-change>>,
  }

  /// Replaces `range` with `text`. Line breaks in `text` are converted to
  /// the document's line ending.
  record text-edit {
    range: range,
    text: string,
  }

  enum severity {
    error,
    warning,
    information,
    hint,
  }

  record diagnostic {
    range: range,
    severity: severity,
    message: string,
    /// A short identifier for the kind of problem, e.g. `line-too-long`.
    code: option<string>,
  }

  /// Capabilities an extension can request in its manifest. Only those the
  /// user grants are available.
  enum permission {
    /// Read open documents, receive their changes, publish diagnostics.
    documents-read,
    /// Edit open documents.
    documents-write,
  }

  enum log-level {
    trace,
    debug,
    info,
    warn,
    error,
  }

  enum message-level {
    info,
    warning,
    error,
  }

  /// A configuration value, of the type declared in the manifest.
  variant config-value {
    boolean(bool),
    integer(s64),
    number(f64),
    text(string),
  }

  variant api-error {
    /// The user has not granted the permission this call needs.
    permission-denied(permission),
    /// No open document has this identifier.
    unknown-document,
    /// The document has changed; it is now at the given version.
    stale-version(u64),
    /// A position is outside the document or inside a character.
    invalid-range(string),
    /// The request exceeds one of the host's limits.
    too-large(string),
    invalid-argument(string),
  }

  /// Passed to `activate`.
  record activation {
    /// The permissions the user has granted.
    granted: list<permission>,
  }

  /// Where a command was run from.
  record command-context {
    /// The document in the active editor, if any.
    document: option<document-id>,
    /// That document's selections, the primary one first.
    selections: list<range>,
  }

  /// The content of a status bar item declared in the manifest. (1.1)
  record status-item {
    /// Plain text, at most 100 characters.
    text: string,
    tooltip: option<string>,
    /// One of the extension's commands, run when the item is clicked.
    command: option<string>,
  }

  /// A row in one of the extension's side bar views. (1.1)
  record view-item {
    /// Unique within the view.
    id: string,
    /// The item this one is nested under; it must come earlier in the list.
    parent: option<string>,
    label: string,
    /// Shown dimmed after the label.
    description: option<string>,
    tooltip: option<string>,
    /// Whether its children are shown at first.
    expanded: bool,
    /// One of the extension's commands, run with `argument` when the item
    /// is activated (see `command-argument`).
    command: option<string>,
    argument: option<string>,
  }

  /// How a table column's cells are aligned. (1.2)
  enum column-alignment {
    none,
    left,
    center,
    right,
  }

  /// Preformatted text in a preview. (1.2)
  record preview-code {
    /// The language it's in, as written after a Markdown code fence: a
    /// language id (`rust`) or file extension (`rs`). Code in a known
    /// language is highlighted.
    language: option<string>,
    text: string,
  }

  /// A link in a preview. Its text is its children. (1.2)
  record preview-link {
    /// A web address (`https:`, `http:`, or `mailto:`), a heading in the
    /// preview (`#name`), or a file relative to the preview's document
    /// (`guide.md`, `docs/setup.md#install`). Anything else is shown as
    /// text.
    destination: string,
    title: option<string>,
  }

  /// A picture in a preview. (1.2)
  record preview-image {
    /// A PNG, JPEG, GIF, WebP, SVG, BMP, ICO, or AVIF file (BMP, ICO, and
    /// AVIF since 1.4) relative to the preview's document, at most 64 MiB.
    /// Web addresses aren't loaded: `description` is shown.
    source: string,
    /// Text describing the picture, shown when it can't be.
    description: string,
    title: option<string>,
  }

  /// What a node of a preview is. Blocks go in the preview itself, in
  /// quotes, and in list items; inline nodes go in paragraphs, headings,
  /// table cells, list items, and other inline nodes. (1.2)
  variant preview-element {
    paragraph,
    /// Level 1 to 6.
    heading(u8),
    quote,
    bulleted-list,
    /// Numbered from the given number.
    numbered-list(u32),
    /// An item of a list; `some(done)` for a task list item.
    list-item(option<bool>),
    code-block(preview-code),
    rule,
    /// One alignment per column.
    table(list<column-alignment>),
    /// A table's header row, holding cells. Rows follow it.
    table-head,
    table-row,
    table-cell,
    text(string),
    emphasis,
    strong,
    strikethrough,
    /// Inline code.
    code(string),
    link(preview-link),
    image(preview-image),
    line-break,
  }

  /// A node of a preview's content. (1.2)
  record preview-node {
    /// The index of the node this one is inside, which must come before
    /// it; `none` for the top level.
    parent: option<u32>,
    element: preview-element,
  }

  /// How to show a preview. (1.2)
  record preview-options {
    /// The tab's title, at most 100 characters.
    title: string,
    /// The document it shows. The preview closes with it, and relative
    /// links and images are found from its folder.
    document: option<document-id>,
    /// Opens it beside the document (or the active editor) instead of in
    /// the same group.
    beside: bool,
  }

  /// A file open in one of the extension's viewers. (1.5)
  record viewed-file {
    /// The viewer's id, as declared in the manifest.
    viewer: string,
    path: string,
  }

  /// An open preview of the extension: its id as declared in the
  /// manifest, and the key it was shown with. (1.5)
  record preview-instance {
    preview: string,
    key: string,
  }

  /// A tab of the extension's that shows a webview page. (1.5)
  variant webview {
    viewer(viewed-file),
    preview(preview-instance),
  }

  /// A message a webview page sent with `flareite.postMessage`. (1.5)
  record webview-message {
    /// The tab whose page sent it.
    source: webview,
    /// The message, as JSON text.
    data: string,
  }
}

/// Functions the editor provides.
interface host {
  use types.{
    api-error, config-value, diagnostic, document-id, document-info, line-slice, log-level,
    message-level, range, text-edit, text-slice,
  };

  /// Writes to the editor's log, tagged with the extension.
  log: func(level: log-level, message: string);

  /// Shows a notification to the user.
  show-message: func(level: message-level, message: string);

  /// A setting declared in the manifest's `configuration`: the user's
  /// value, or the declared default. `none` for undeclared keys.
  configuration: func(key: string) -> option<config-value>;

  /// The open documents.
  documents: func() -> result<list<document-info>, api-error>;

  document: func(id: document-id) -> result<document-info, api-error>;

  /// Lines `start` up to (not including) `end`, clamped to the document.
  read-lines: func(id: document-id, start: u32, end: u32) -> result<line-slice, api-error>;

  read-range: func(id: document-id, range: range) -> result<text-slice, api-error>;

  /// Applies `edits` as one undoable change if the document is still at
  /// `version`; all or none are applied. Ranges refer to the text at
  /// `version` and must not overlap. Returns the new version.
  apply-edits: func(id: document-id, version: u64, edits: list<text-edit>) -> result<u64, api-error>;

  /// Replaces this extension's diagnostics for a document. Ranges refer to
  /// the text at `version`, which must be the current version or one
  /// recently sent to the extension.
  publish-diagnostics: func(
    id: document-id,
    version: u64,
    diagnostics: list<diagnostic>,
  ) -> result<_, api-error>;

  /// Changes one of the extension's settings in the user's settings, or
  /// removes it there (`none`), which restores its default. The value must
  /// fit the setting's declaration. Use it for choices the user makes, such
  /// as "Always" in a prompt. (1.7)
  set-configuration: func(key: string, value: option<config-value>) -> result<_, api-error>;
}

/// Contributions to the workbench: status bar items, side bar views,
/// editor decorations, and previews, all declared in the manifest. (1.1)
interface workbench {
  use types.{api-error, document-id, preview-node, preview-options, range, status-item, view-item};

  /// Shows a status bar item with new content, or hides it (`none`).
  set-status-item: func(id: string, item: option<status-item>) -> result<_, api-error>;

  /// Replaces the items of a side bar view (at most 5,000).
  set-view-items: func(view: string, items: list<view-item>) -> result<_, api-error>;

  /// Shows a message in a view instead of (or above) its items, e.g. while
  /// it is empty; `none` removes it.
  set-view-message: func(view: string, message: option<string>) -> result<_, api-error>;

  /// Shows a side bar view.
  show-view: func(view: string) -> result<_, api-error>;

  /// Replaces the ranges decorated with one of the extension's decoration
  /// types in a document. Ranges refer to the text at `version`, as for
  /// diagnostics. Needs the `documents-read` permission.
  set-decorations: func(
    id: document-id,
    version: u64,
    decoration: string,
    ranges: list<range>,
  ) -> result<_, api-error>;

  /// Selects `range` in a document and scrolls it into view, making it the
  /// active document. Needs the `documents-read` permission.
  reveal: func(id: document-id, range: range) -> result<_, api-error>;

  /// The argument the running command was invoked with, from a view item
  /// or an explorer menu (the file's or folder's path); `none` otherwise.
  command-argument: func() -> option<string>;

  /// Opens one of the extension's previews in a tab, or shows it if it's
  /// open. `key` tells apart the previews of one type, e.g. one per
  /// document. Showing a document's preview needs the `documents-read`
  /// permission. (1.2)
  show-preview: func(preview: string, key: string, options: preview-options) -> result<_, api-error>;

  /// Replaces the content of an open preview: at most 100,000 nodes and
  /// 8 MiB of text. Returns false, changing nothing, if the preview isn't
  /// open (the user closed it), so the extension can stop updating it.
  /// (1.2)
  set-preview-content: func(preview: string, key: string, nodes: list<preview-node>) -> result<bool, api-error>;

  /// Closes a preview, if it's open. (1.2)
  close-preview: func(preview: string, key: string) -> result<_, api-error>;

  /// Markdown as preview nodes, for `set-preview-content` or
  /// `viewers::set-viewer-content`: the editor's own renderer, which shows
  /// extensions' READMEs. CommonMark with GitHub's tables, strikethrough,
  /// and task lists; HTML is reduced to its text and front matter is left
  /// out, and a document too long for a preview is cut with a note. At
  /// most 8 MiB of text (`too-large` otherwise). Needs no permission.
  /// (1.14)
  render-markdown: func(text: string) -> result<list<preview-node>, api-error>;

  /// The file of the editor in use, if it shows one: a document's, a
  /// viewer's, or a diff's modified file. The manifest's
  /// `on_active_file_changed` command runs when it changes. (1.11)
  active-file: func() -> option<string>;

  /// A link shown above a line of a document, as VS Code's code lenses:
  /// clicking it runs one of the extension's commands with `argument`
  /// (`command-argument`), for the document. (1.12)
  record code-lens {
    line: u32,
    /// Plain text, at most 100 characters.
    title: string,
    tooltip: option<string>,
    command: string,
    argument: option<string>,
  }

  /// Replaces this extension's code lenses in a document (at most 1,000).
  /// Lines refer to the text at `version`, as for diagnostics, and follow
  /// its edits. Needs the `documents-read` permission. (1.12)
  set-code-lenses: func(id: document-id, version: u64, lenses: list<code-lens>) -> result<_, api-error>;

  /// Faint text shown after a line's end, such as who last changed it.
  /// (1.13)
  record line-annotation {
    line: u32,
    /// Plain text, at most 200 characters.
    text: string,
    /// Shown on hover; plain text, at most 2,000 characters.
    tooltip: option<string>,
  }

  /// Replaces this extension's line annotations in a document (at most
  /// 100,000; one per line). Like code lenses, lines refer to the text at
  /// `version` and follow its edits. Needs the `documents-read`
  /// permission. The manifest's `on_selection_changed` command runs (with
  /// the document and its selections as its context) when the cursor
  /// moves to another line, so an extension can annotate just the line
  /// in use. (1.13)
  set-line-annotations: func(id: document-id, version: u64, annotations: list<line-annotation>) -> result<_, api-error>;
}

/// Files in the folder open in the editor, e.g. to format every file in a
/// folder from the explorer's menu. Reading needs the `files-read`
/// permission and writing `files-write` (they aren't listed in
/// `activation.granted`). Paths are absolute, and only files inside the
/// open folder can be used. (1.3)
interface files {
  /// Why a file call failed.
  variant file-error {
    /// The permission the call needs (`files-read` or `files-write`) isn't
    /// granted.
    permission-denied(string),
    /// No folder is open, or the path isn't inside it.
    outside-folder,
    not-found,
    /// A folder was given where a file is needed, or the other way round.
    wrong-kind,
    /// The file isn't text: it looks binary. (Text in other encodings
    /// than UTF-8 is read and written in its own encoding.)
    not-text,
    /// The request exceeds one of the host's limits.
    too-large(string),
    /// The file couldn't be read or written; why.
    failed(string),
  }

  /// Files found by `list-files`.
  record file-list {
    /// Absolute paths, sorted.
    paths: list<string>,
    /// Whether more files were there than are listed.
    truncated: bool,
  }

  /// The open folder, if there is one.
  folder: func() -> result<option<string>, file-error>;

  /// The files in `folder` and its subfolders, except those the user's
  /// `files.exclude` setting hides and those Git ignores: at most 10,000.
  list-files: func(folder: string) -> result<file-list, file-error>;

  /// The text of a file, line breaks included. A file open in the editor
  /// is read from its document, unsaved changes included.
  read-file: func(path: string) -> result<string, file-error>;

  /// Replaces the text of a file, or creates the file in an existing
  /// folder. Line breaks in `text` are converted to the file's line ending
  /// (a new file gets them as written). A file open in the editor is
  /// changed in its document, as one change the user can undo, and saved
  /// unless it had unsaved changes. Writing the text a file already has
  /// changes nothing.
  write-file: func(path: string, text: string) -> result<_, file-error>;

  /// Deletes a file or a folder and everything in it: to the system's
  /// trash (the Recycle Bin on Windows), where the user can restore it, or
  /// permanently. Needs `files-write`. Fails, deleting nothing, if the
  /// trash can't take it. (1.7)
  delete: func(path: string, to-trash: bool) -> result<_, file-error>;
}

/// Files opened in one of the extension's viewers: tabs that show a file
/// the way the extension draws it, such as an image, instead of as text.
/// A viewer is declared in the manifest with the file names it opens and
/// the command that fills it in, which runs with the file's path as its
/// argument (see `command-argument`) whenever the file is opened in the
/// viewer or changes on disk. A webview viewer (1.5) shows a page instead,
/// and needs no command. Viewers need no permission: a viewer can read
/// only the files open in it. (1.4)
interface viewers {
  use types.{api-error, preview-node};

  /// Bytes read from a file open in a viewer.
  record file-bytes {
    /// The size of the whole file.
    size: u64,
    /// The bytes from the offset asked for: fewer than asked for at the
    /// end of the file.
    bytes: list<u8>,
  }

  /// Replaces what one of the extension's viewers shows for a file, with
  /// the same content a preview has: at most 100,000 nodes and 8 MiB of
  /// text. Pictures and links are found from the file's folder, so a
  /// picture of the file itself is its name. Returns false, changing
  /// nothing, if the file isn't open in the viewer (the user closed it).
  set-viewer-content: func(viewer: string, path: string, nodes: list<preview-node>) -> result<bool, api-error>;

  /// Reads up to `length` bytes (at most 16 MiB) of a file open in one of
  /// the extension's viewers, starting at `offset`.
  read-viewed-file: func(viewer: string, path: string, offset: u64, length: u32) -> result<file-bytes, api-error>;
}

/// Pages that viewers and previews show instead of preview content: HTML,
/// styles, and scripts from the extension's folder, or HTML the extension
/// sets. A viewer or preview is a webview when its manifest entry has
/// `webview`. Its page runs sandboxed: it can load only the extension's
/// files and, in a viewer, the file open in it, and can't reach the editor
/// except by messages. The page sends them with `flareite.postMessage`,
/// which runs the command named by the entry's `on_message` (see
/// `message`), and receives them with `flareite.onMessage`. (1.5)
interface webviews {
  use types.{api-error, webview, webview-message};

  /// Replaces the page a webview shows with `html` (at most 4 MiB), and
  /// loads it. Relative addresses in it are found in the extension's
  /// folder. Returns false, changing nothing, if the tab isn't open.
  set-webview-html: func(webview: webview, html: string) -> result<bool, api-error>;

  /// Sends a message, as JSON text (at most 1 MiB), to a webview's page,
  /// which receives it parsed. Messages sent before the page has loaded
  /// wait for it. Returns false if the tab isn't open.
  post-message: func(webview: webview, message: string) -> result<bool, api-error>;

  /// The message the running command was run for, when it's a webview's
  /// `on_message` command; `none` otherwise.
  message: func() -> option<webview-message>;
}

/// Small values the extension keeps across sessions, as JSON text: global
/// ones, and the open folder's. Its webview pages share them
/// (`flareite.storage`, `flareite.workspaceStorage`). Each scope holds at most
/// 1 MiB, and keys are at most 200 bytes. Users can clear what an extension
/// stores. Needs no permission. (1.5)
interface storage {
  use types.{api-error};

  enum storage-scope {
    /// Shared by every folder.
    global,
    /// The folder open in the editor; nothing is kept while none is.
    workspace,
  }

  /// A value, as JSON text; `none` if there is none.
  get: func(scope: storage-scope, key: string) -> option<string>;

  /// Sets a value (JSON text), or removes it (`none`).
  set: func(scope: storage-scope, key: string, value: option<string>) -> result<_, api-error>;

  /// The keys that have values, sorted.
  keys: func(scope: storage-scope) -> list<string>;
}

/// The folder open in the editor, whether the user trusts it, and changes
/// to files on disk. (1.6)
///
/// The manifest's `on_folder_changed` command runs when the open folder
/// changes (opened, closed, or another one opened) or the user changes
/// whether they trust it.
interface workspace {
  use files.{file-error};

  record folder-info {
    /// Absolute.
    path: string,
    /// Whether the user trusts the folder's files. Programs (the
    /// `processes` interface) run only in a trusted folder, since programs
    /// such as Git and build tools may run code from it. With no folder
    /// open, nothing needs trust.
    trusted: bool,
  }

  /// The open folder, if any. Needs no permission.
  folder: func() -> option<folder-info>;

  /// Asks the user whether they trust the open folder, if they haven't
  /// trusted it. Their answer runs `on_folder_changed`.
  request-trust: func();

  /// Opens a file in the editor, as if the user opened it, and shows it.
  /// Needs no permission. (1.7)
  open-file: func(path: string) -> result<_, file-error>;

  /// Opens a file in the open folder with the system's default app for
  /// its kind, such as a built place in Roblox Studio. Needs the
  /// `processes` permission (`permission-denied` otherwise) and a trusted
  /// folder; programs and scripts (`.exe`, `.bat`, `.sh`, executable
  /// files, ...) aren't opened. (1.17)
  open-externally: func(path: string) -> result<_, file-error>;

  /// Changes to files under a watched path, reported to its command.
  record file-changes {
    /// What `watch` returned.
    watch: u64,
    /// The files and folders that were created, changed, or removed,
    /// absolute and sorted. Only paths under the watched one.
    paths: list<string>,
    /// Too many changed to list (more than 10,000), so `paths` is empty:
    /// look again at everything under the watched path.
    overflow: bool,
  }

  /// Watches a file, or a folder and everything in it. When something
  /// under it changes, `command` (one of the extension's own) runs, during
  /// which `changes` lists what did. Changes that arrive while the
  /// extension is busy are merged into one call.
  ///
  /// A path inside the open folder needs `files-read`, and is watched only
  /// while that folder is open, `.git` included. A path outside it needs
  /// `processes` (which can read it anyway). At most 32 watches.
  watch: func(path: string, command: string) -> result<u64, file-error>;

  /// Stops a watch. Watches also stop when the extension does.
  unwatch: func(watch: u64);

  /// The changes the running command was run for, when it's a watch's
  /// command; `none` otherwise.
  changes: func() -> option<file-changes>;

  /// Opens a folder in the editor in place of the open one, as if the user
  /// chose it (they're asked whether to trust it, as usual). (1.11)
  open-folder: func(path: string) -> result<_, file-error>;
}

/// Programs the manifest declares in `[[programs]]`, which run on the
/// user's computer as the user. Needs the `processes` permission, and a
/// trusted folder (or none). (1.6)
interface processes {
  variant process-error {
    /// The `processes` permission isn't granted.
    permission-denied,
    /// The open folder isn't trusted (see `workspace::folder`).
    untrusted,
    /// The manifest declares no program with this name.
    unknown-program(string),
    /// The program isn't installed, or couldn't be started; why.
    not-found(string),
    /// It ran longer than allowed and was stopped.
    timed-out,
    /// It was stopped with `kill`.
    killed,
    /// The request exceeds one of the host's limits.
    too-large(string),
    invalid-argument(string),
    failed(string),
  }

  record process-options {
    /// The folder it runs in, absolute; the open folder by default (which
    /// must then be open).
    cwd: option<string>,
    /// Variables added to Flareite's environment, or replacing its values.
    env: list<tuple<string, string>>,
    /// Written to its standard input, which is then closed. Without it,
    /// its input is empty.
    stdin: option<list<u8>>,
    /// Stops it after this long. `run` stops it at the running command's
    /// deadline in any case, and `spawn` lets it run until it ends.
    timeout-ms: option<u32>,
  }

  record process-output {
    /// `none` when it didn't exit by itself (it was stopped by a signal).
    exit-code: option<s32>,
    stdout: list<u8>,
    stderr: list<u8>,
    /// Output beyond 32 MiB (standard output and error together) was
    /// dropped.
    truncated: bool,
  }

  /// Runs a declared program with `args` and waits for it to end, within
  /// the running call's deadline.
  run: func(program: string, args: list<string>, options: process-options) -> result<process-output, process-error>;

  /// Starts a declared program and returns at once. When it ends, `command`
  /// (one of the extension's own) runs, during which `finished` returns
  /// its outcome. At most 16 run at once; they are stopped when the
  /// extension stops.
  spawn: func(program: string, args: list<string>, options: process-options, command: string) -> result<u64, process-error>;

  /// Stops a program `spawn` started, and everything it started. Its
  /// command still runs, with `killed`. Returns false if it had ended.
  kill: func(process: u64) -> bool;

  /// A program that `spawn` started, and how it ended.
  record finished-process {
    /// What `spawn` returned.
    process: u64,
    outcome: result<process-output, process-error>,
  }

  /// The program the running command was run for, when it's a `spawn`
  /// command; `none` otherwise.
  finished: func() -> option<finished-process>;

  /// A line a program wrote. (1.17)
  record output-line {
    /// To standard error, rather than standard output.
    stderr: bool,
    /// Without its line ending; invalid UTF-8 is replaced. Lines longer
    /// than 16 KiB are cut.
    text: string,
  }

  /// Lines a program `spawn-streaming` started wrote. (1.17)
  record process-lines {
    /// What `spawn-streaming` returned.
    process: u64,
    /// In the order they were written (standard output's and error's
    /// relative order as they were read).
    lines: list<output-line>,
    /// Lines left out because the extension fell more than 1 MiB behind.
    dropped: u32,
  }

  /// Starts a declared program as `spawn` does, but hands its output to the
  /// extension as it's written: `output` (one of its own commands) runs
  /// with the lines written since it last ran, during which `lines`
  /// returns them. Every line is handed over before `command` runs for the
  /// program's end, whose outcome then has empty `stdout` and `stderr`.
  /// For programs that run until stopped, such as servers and watchers.
  /// (1.17)
  spawn-streaming: func(program: string, args: list<string>, options: process-options, command: string, output: string) -> result<u64, process-error>;

  /// The lines the running command was run for, when it's a
  /// `spawn-streaming` output command; `none` otherwise. (1.17)
  lines: func() -> option<process-lines>;
}

/// Marks on files and folders in the explorer, such as a version control
/// status: a color, a short badge, and a tooltip. Needs no permission. (1.6)
interface explorer {
  use types.{api-error};

  record file-mark {
    /// Absolute.
    path: string,
    /// One or two characters shown at the end of the row, such as `M`.
    badge: option<string>,
    /// The name of a color the manifest declares under `[colors]`, for the
    /// row's text.
    color: option<string>,
    /// Plain text, such as "Modified".
    tooltip: option<string>,
    /// Shows the row dimmed.
    faded: bool,
    /// Marks everything inside a folder too, as with an untracked folder.
    inherit: bool,
    /// Folders that contain it show its color and a dot. Where marks
    /// propagate to the same folder, the highest `priority` wins.
    propagate: bool,
    priority: u8,
  }

  /// Replaces all of the extension's marks: at most 100,000, one per path.
  set-file-marks: func(marks: list<file-mark>) -> result<_, api-error>;
}

/// Side bar views as trees, in API 1.7: items with icons, marks, and
/// children loaded when opened; buttons and menus for the view and its
/// items (declared in the manifest); a text box; a welcome message; and a
/// count badge. Views can be sections of one container (`container` in the
/// manifest), shown together under one activity bar entry. Needs no
/// permission.
interface views {
  use types.{api-error};

  variant item-icon {
    none,
    /// A named icon, as for tab actions (`add`, `check`, `refresh`, ...).
    named(string),
    /// The file icon theme's icon for a file with this path or name.
    file(string),
    /// The file icon theme's icon for a folder with this path or name.
    folder(string),
  }

  /// How an item looks besides its label, as explorer marks do.
  record item-mark {
    /// One or two characters at the end of the row, such as `M`.
    badge: option<string>,
    /// The name of a color the manifest declares under `[colors]`, for the
    /// label and the badge.
    color: option<string>,
    /// Strikes the label through, as for a deleted file.
    strikethrough: bool,
    faded: bool,
  }

  enum expansion {
    /// A leaf, unless items name it as their parent.
    none,
    collapsed,
    expanded,
  }

  record tree-item {
    /// Unique within the view.
    id: string,
    /// The item it's nested under, which must come earlier in the list.
    parent: option<string>,
    label: string,
    /// Shown dimmed after the label.
    description: option<string>,
    tooltip: option<string>,
    icon: item-icon,
    mark: option<item-mark>,
    /// Which of the manifest's `view/item` menus apply to it: those whose
    /// `contexts` list this.
    context: option<string>,
    /// Whether it can be opened, and is at first. An item that can be
    /// opened but has no children listed gets them when it's opened: the
    /// view's `on_expand` command runs, and calls `set-children`.
    expansion: expansion,
    /// Run with `argument` when the item is activated (click or Enter).
    command: option<string>,
    argument: option<string>,
  }

  /// Replaces the items of one of the extension's views: at most 10,000,
  /// children loaded with `set-children` included.
  set-items: func(view: string, items: list<tree-item>) -> result<_, api-error>;

  /// Replaces the children of an item (and theirs). Their parents must be
  /// `parent` or an item listed before them. Returns false, changing
  /// nothing, if the view has no such item any more.
  set-children: func(view: string, parent: string, items: list<tree-item>) -> result<bool, api-error>;

  /// A button in a welcome message.
  record welcome-button {
    label: string,
    /// One of the extension's commands, run with `argument`.
    command: string,
    argument: option<string>,
  }

  /// Shown in a view instead of its items while it has none.
  record welcome {
    /// Plain text; a blank line starts a paragraph.
    text: string,
    buttons: list<welcome-button>,
  }

  set-welcome: func(view: string, welcome: option<welcome>) -> result<_, api-error>;

  /// A number on the view's header and on its activity bar entry (added up
  /// for a container's sections); 0 shows none.
  set-badge: func(view: string, count: u32) -> result<_, api-error>;

  /// The flags the view's menus test with `when` (`"tree"`, `"!tree"`).
  set-flags: func(view: string, names: list<string>) -> result<_, api-error>;

  /// The text in the view's text box (declared with `[views.input]`).
  input: func(view: string) -> result<string, api-error>;

  /// Replaces the text in the view's text box.
  set-input: func(view: string, text: string) -> result<_, api-error>;

  /// The items a command from a view's menu or button was run for: the
  /// arguments of the selected items, when the clicked item is one of
  /// them, or of the clicked item alone. Empty otherwise.
  selection: func() -> list<string>;

  /// An item being opened, for the view's `on_expand` command.
  record expanding-item {
    view: string,
    item: string,
    argument: option<string>,
  }

  /// The item the running command was run to load children for, when it's
  /// a view's `on_expand` command; `none` otherwise.
  expanding: func() -> option<expanding-item>;

  /// A lane of a history graph: what it leads to (a commit, say), and its
  /// color, 0 to 4 by turns. (1.11)
  record graph-lane {
    id: string,
    color: u32,
  }

  /// A row of a history graph, beside a view item. (1.11)
  record graph-row {
    /// The item it's beside.
    item: string,
    /// What its node is: the lanes coming in for it end at the node.
    node: string,
    /// What the node leads to: a lane leaves it for each.
    parents: list<string>,
    /// The lanes at the row's top and bottom, left to right. A lane at the
    /// top for something else carries on to the bottom lane for the same.
    inputs: list<graph-lane>,
    outputs: list<graph-lane>,
  }

  /// Draws a history graph beside a view's items, in VS Code's style: one
  /// row per item it names (at most 10,000, with 64 lanes each). Rows of
  /// items it doesn't name (an opened commit's files) carry the lanes on.
  /// It replaces the view's graph; an empty list removes it. (1.11)
  set-graph: func(view: string, rows: list<graph-row>) -> result<_, api-error>;

  /// Shows or hides one of the extension's views (a section hides from its
  /// container). Views start as the manifest's `hidden` says. (1.13)
  set-visible: func(view: string, visible: bool) -> result<_, api-error>;
}

/// Asking the user something: choosing from a list, typing text, or
/// confirming. Each returns at once with the prompt's id; the answer runs
/// the given command, during which `answer` returns it. One prompt shows at
/// a time: a new one cancels the one showing. Needs no permission. (1.7)
interface prompts {
  use types.{api-error};

  record pick-item {
    label: string,
    /// Shown dimmed after the label.
    description: option<string>,
    /// What `answer` returns when it's chosen.
    value: string,
  }

  /// Shows a list to choose from (at most 1,000 items), filtered as the
  /// user types. `title` says what's being chosen.
  pick: func(title: string, items: list<pick-item>, command: string) -> result<u64, api-error>;

  record input-options {
    /// Says what to type.
    title: string,
    /// The text at first.
    value: string,
    placeholder: option<string>,
  }

  /// Asks for a line of text.
  input: func(options: input-options, command: string) -> result<u64, api-error>;

  /// Asks for a line of text that's hidden as it's typed, such as a
  /// password or an API key. Flareite doesn't log the answer. (1.17)
  input-password: func(options: input-options, command: string) -> result<u64, api-error>;

  record confirm-options {
    message: string,
    /// More about it, shown below.
    detail: option<string>,
    /// The choices, the first being the main one; Cancel is added.
    buttons: list<string>,
    /// The main choice destroys something (it's shown as a warning).
    destructive: bool,
  }

  /// Asks the user to confirm, in a dialog.
  confirm: func(options: confirm-options, command: string) -> result<u64, api-error>;

  variant answer-value {
    /// Closed without an answer, or replaced by another prompt.
    cancelled,
    /// A `pick`'s chosen item's value.
    picked(string),
    /// An `input`'s text.
    text(string),
    /// The index of a `confirm`'s button.
    button(u32),
  }

  record prompt-answer {
    /// What the prompt function returned.
    prompt: u64,
    value: answer-value,
  }

  /// The answer the running command was run for; `none` otherwise.
  answer: func() -> option<prompt-answer>;

  /// Asks for a folder, in the system's dialog. The answer is
  /// `text(path)`, an absolute path. (1.11)
  pick-folder: func(title: string, command: string) -> result<u64, api-error>;
}

/// Read-only documents the extension provides for addresses of its own,
/// and tabs comparing two documents. (1.8)
///
/// The manifest's `[[text_providers]]` declare schemes, such as `git`, with
/// the command that provides the text at an address (`git:HEAD:src/main.rs`)
/// when the editor needs it: when a tab shows it, and again after `changed`.
/// While that command runs, `requested` returns the address, and the
/// command answers with `provide`. Needs no permission.
interface documents {
  use types.{api-error, document-id};

  /// The address the running command was run to provide text for, when
  /// it's a text provider's command; `none` otherwise.
  requested: func() -> option<string>;

  /// Answers a request: the text at `uri` (at most 32 MiB), or `none` when
  /// there's nothing there, which shows as empty.
  provide: func(uri: string, text: option<string>) -> result<_, api-error>;

  /// The texts at these addresses of the extension's may have changed, so
  /// open documents showing them ask for them again. An address ending in
  /// `*` stands for every address starting with what's before it
  /// (`git:*` for all of a scheme's).
  changed: func(uris: list<string>) -> result<_, api-error>;

  /// Opens the document at one of the extension's addresses, read-only, in
  /// a tab of its own.
  open: func(uri: string) -> result<_, api-error>;

  /// Opened a tab comparing two documents until 1.15. Diff tabs are now
  /// built by extensions with `layouts` (Git's are), so this fails with
  /// `invalid-argument`. Kept so components built against 1.8 to 1.14
  /// still load.
  open-diff: func(original: string, modified: string, title: string) -> result<_, api-error>;

  /// One of the versions a merge combines. (1.12)
  record merge-side {
    /// An absolute path, or an address an extension provides.
    uri: string,
    /// Such as "Incoming" or "Current".
    title: string,
    /// Such as the branch or commit it's from.
    description: option<string>,
  }

  record merge-options {
    /// The versions' common ancestor (an absolute path or an address).
    base: string,
    /// Shown on the left above the result.
    incoming: merge-side,
    /// Shown on the right above the result.
    current: merge-side,
    /// The file the merge writes: an absolute path.
    result-file: string,
    /// The tab's title.
    title: string,
    /// Start the result again from the base with the changes that don't
    /// conflict made, e.g. when the file holds conflict markers.
    reset-result: bool,
    /// Runs when the user completes the merge, after the result is saved,
    /// with the result's path as the argument (`workbench::command-argument`).
    on-complete: option<string>,
  }

  /// Opened a merge editor from 1.12 until 1.15. Merge editors are now
  /// built by extensions with `layouts` (Git's is), so this fails with
  /// `invalid-argument`. Kept so components built against 1.12 to 1.14
  /// still load.
  open-merge: func(options: merge-options) -> result<_, api-error>;

  /// Saves an open document to its file, as the user's Save does but
  /// without asking anything: e.g. a merge's result before staging it.
  /// Fails with `invalid-argument` for a document without a file (a
  /// provided one, or a new file). Needs the `documents-write` permission.
  /// (1.15)
  save: func(id: document-id) -> result<_, api-error>;
}

/// Tabs split into panes (1.15): editors, pages of the extension's own
/// (webviews), and files of the open folder shown as web pages, side by
/// side or stacked, each with an optional header of buttons. Git's diff and
/// merge editors are layouts, and so is HTML & CSS's live preview.
///
/// The manifest's `[[layouts]]` declare them, each with the command that
/// fills a tab in (`command`): the workbench runs it when a tab opens, is
/// restored, crosses one of its width `breakpoints`, has its documents
/// open (`ready`), and closes. While it runs, `filling` says which tab and
/// why; the command answers with `set-layout`. A layout with `patterns`
/// is for files: its tabs' keys are the files' paths, and the user can
/// open a matching file in it (always, with `priority = "default"`), or
/// switch a file's tab to it and back.
///
/// Commands run from a layout's buttons and zones get their `argument`
/// from `workbench::command-argument` and the tab from `invoked`.
interface layouts {
  use types.{api-error, document-id, range};

  /// A tab showing one of the extension's layouts.
  record layout-tab {
    /// The layout's id, as the manifest declares it (`diff`).
    layout: string,
    /// Tells apart the tabs of one layout, at most 4 KiB. For a layout
    /// with `patterns`, the file's absolute path.
    key: string,
  }

  /// How a split arranges what's in it.
  enum direction {
    /// Side by side, left to right.
    row,
    /// Stacked, top to bottom.
    column,
  }

  /// A button: in a pane's header, or beside the tab.
  record button {
    /// Unique among its neighbours.
    id: string,
    /// Its tooltip and accessible name, and its text when it has no icon.
    /// At most 100 characters.
    title: string,
    /// A named icon (as for tab actions); `none` shows the title as text.
    icon: option<string>,
    /// One of the extension's commands, run with `argument`.
    command: string,
    argument: option<string>,
    /// Drawn as the main button, as Complete Merge is.
    primary: bool,
    /// A toggle, on or off; `none` for a plain button.
    pressed: option<bool>,
    disabled: bool,
  }

  /// A document in an editor.
  record editor-pane {
    /// A file's absolute path, or an address an extension provides
    /// (`documents`). A file can be edited; a provided text can't.
    uri: string,
    /// A minimap beside it, as the user's setting has it for other editors.
    minimap: bool,
    /// The user can fold regions. Folds `set-pane-decorations` sets are
    /// shown either way.
    folding: bool,
    /// Changed lines marked beside the text (`quick-diff`).
    quick-diff: bool,
  }

  variant pane-content {
    editor(editor-pane),
    /// A page of the extension's, sandboxed as webviews are: an HTML file
    /// in its folder, or `none` for HTML set with `set-pane-html`. Its
    /// messages run the layout's `on_message` command.
    webview(option<string>),
    /// A file of the open folder (an absolute path) shown as a web page:
    /// the folder's files are served to it as they are in the editor,
    /// unsaved changes included, and it shows again as they change. Its
    /// scripts run, sandboxed as webviews are. Only in a trusted folder.
    file-page(string),
    /// A page from the web (an `https:` or `http:` address) in a browser
    /// view of its own, as a browser tab shows it: the user can follow its
    /// links and sign in to sites. It can't reach Flareite. The layout's
    /// `on_navigate` command hears where it goes (`navigated`), and
    /// `navigate-pane` moves it. Needs the `web-pages` permission.
    web-page(string),
  }

  /// A row above a pane.
  record pane-header {
    /// At most 200 characters.
    title: string,
    /// Fainter text after the title, at most 500 characters.
    description: option<string>,
    /// At the header's end, at most 20.
    buttons: list<button>,
  }

  record pane {
    content: pane-content,
    header: option<pane-header>,
    /// Panes with the same group scroll together, line for line where
    /// their zones line their rows up.
    scroll-group: option<string>,
  }

  variant node-kind {
    split(direction),
    pane(pane),
  }

  /// A split or a pane. WIT has no recursive types, so a layout lists its
  /// nodes, each naming the split it's in.
  record layout-node {
    /// Unique in the layout, at most 100 characters; names a pane in the
    /// functions below.
    id: string,
    /// The split it's in, which comes before it; `none` only for the first
    /// node, which fills the tab.
    parent: option<string>,
    /// Its share of the split, relative to its siblings' (`0` counts as
    /// 1). The user can drag the line between them.
    size: f32,
    kind: node-kind,
  }

  record layout {
    /// The tab's title, at most 200 characters.
    title: string,
    /// At most 32 nodes and 16 panes.
    nodes: list<layout-node>,
    /// Documents (paths or addresses) kept open while the tab is, besides
    /// its editors': e.g. those whose lines a zone shows.
    documents: list<string>,
    /// Shown beside the tab while it's active, at most 20.
    buttons: list<button>,
    /// Tab widths, in pixels, whose crossing runs the command again
    /// (`resized`): a diff shows inline when it's narrow.
    breakpoints: list<u32>,
    /// The pane focused when the tab opens, whose file is the tab's (the
    /// active file, the explorer's mark on the tab).
    main: option<string>,
  }

  /// Why the layout's command runs.
  enum fill-reason {
    /// A tab was opened: set its layout.
    opened,
    /// A tab came back without its layout: restored with the window, or
    /// the extension started again. Set its layout.
    restored,
    /// It crossed one of its breakpoints.
    resized,
    /// The documents of its layout are open (`documents`), first or after
    /// the layout named others.
    ready,
    /// It closed: forget it.
    closed,
  }

  record fill-request {
    tab: layout-tab,
    reason: fill-reason,
    /// The tab's width in pixels (0 when unknown).
    width: u32,
  }

  /// While the layout's command runs: the tab, and why; `none` otherwise.
  filling: func() -> option<fill-request>;

  /// Opens a tab of one of the extension's layouts, or shows it if it's
  /// open: in the active group, or beside it. The command fills it in.
  open: func(tab: layout-tab, beside: bool) -> result<_, api-error>;

  /// Sets what an open tab shows. Returns false, changing nothing, if it
  /// isn't open.
  set-layout: func(tab: layout-tab, layout: layout) -> result<bool, api-error>;

  /// Closes a tab, if it's open.
  close: func(tab: layout-tab);

  /// The extension's open tabs.
  tabs: func() -> list<layout-tab>;

  /// One of a tab's open documents.
  record tab-document {
    /// As the layout names it.
    uri: string,
    document: document-id,
    /// The editor panes showing it.
    panes: list<string>,
  }

  /// The documents of a tab's layout that are open: all of them once the
  /// command has run for `ready`.
  documents: func(tab: layout-tab) -> result<list<tab-document>, api-error>;

  /// Lines `start` to `end` (exclusive).
  record line-range {
    start: u32,
    end: u32,
  }

  /// Ranges decorated with one of the extension's decoration types.
  record decorated {
    decoration: string,
    ranges: list<range>,
  }

  /// A link in a row of them, drawn as code lenses are.
  record zone-link {
    /// At most 100 characters.
    title: string,
    tooltip: option<string>,
    command: string,
    argument: option<string>,
  }

  record zone-text {
    /// At most 200 characters.
    text: string,
    tooltip: option<string>,
    command: option<string>,
    argument: option<string>,
  }

  record zone-links {
    /// Plain text before the links, at most 100 characters.
    label: option<string>,
    /// At most 10; none leaves an empty row (lining up a row of links in
    /// another pane).
    links: list<zone-link>,
  }

  record zone-lines {
    /// One of the tab's documents.
    uri: string,
    lines: line-range,
    /// In that document's lines.
    decorations: list<decorated>,
    /// Its line numbers beside them.
    numbers: bool,
  }

  variant zone-content {
    /// This many empty rows, hatched: lines up the rows of panes that
    /// scroll together.
    filler(u32),
    /// A row of text, such as "12 unchanged lines"; clicking it runs
    /// `command` when there is one.
    text(zone-text),
    /// A row of links after an optional label.
    links(zone-links),
    /// Lines of another of the tab's documents (`layout.documents`),
    /// highlighted, with decorations of their own: removed lines in an
    /// inline diff. At most 10,000 lines.
    lines(zone-lines),
  }

  /// Rows between an editor's lines.
  record zone {
    /// The line it's above; the line count puts it after the last.
    line: u32,
    content: zone-content,
    /// A decoration type whose background it has.
    decoration: option<string>,
  }

  /// A mark beside an editor's scroll bar.
  record ruler-mark {
    lines: line-range,
    /// A decoration type, whose border color or else background it has.
    decoration: string,
  }

  /// What the extension shows in an editor pane besides the text. Unlike
  /// document decorations, it isn't moved by edits: it refers to the text
  /// when it was set, and the extension sets it again as the text changes.
  record pane-decorations {
    /// At most 50,000 ranges in all.
    decorations: list<decorated>,
    /// At most 10,000.
    zones: list<zone>,
    /// Lines hidden as folded regions, at most 10,000: unchanged lines in
    /// a diff.
    folds: list<line-range>,
    /// At most 10,000.
    ruler: list<ruler-mark>,
  }

  /// Replaces what an editor pane shows besides its text. Returns false if
  /// the tab isn't open or the pane isn't one of its editors.
  set-pane-decorations: func(tab: layout-tab, pane: string, decorations: pane-decorations) -> result<bool, api-error>;

  /// Selects a range in an editor pane and scrolls it to the middle,
  /// focusing the pane. Returns false if it isn't open.
  reveal: func(tab: layout-tab, pane: string, range: range) -> result<bool, api-error>;

  /// An editor pane, and its document's selections.
  record pane-selection {
    tab: layout-tab,
    pane: string,
    document: document-id,
    /// The primary one first.
    selections: list<range>,
  }

  /// The editor pane in use, when it's in one of the extension's tabs:
  /// for commands such as "Stage Selected Ranges".
  active-pane: func() -> option<pane-selection>;

  /// Where a command run from a layout's button or zone was clicked: the
  /// tab, and the pane (`none` for the tab's own buttons).
  record invoked-from {
    tab: layout-tab,
    pane: option<string>,
  }

  /// For a command run from a layout's button or zone; `none` otherwise.
  invoked: func() -> option<invoked-from>;

  /// Replaces a webview pane's page with `html` (at most 4 MiB), as
  /// `webviews::set-webview-html` does. Returns false if it isn't open.
  set-pane-html: func(tab: layout-tab, pane: string, html: string) -> result<bool, api-error>;

  /// Sends a message (JSON text, at most 1 MiB) to a webview pane's page.
  /// Returns false if it isn't open.
  post-message: func(tab: layout-tab, pane: string, message: string) -> result<bool, api-error>;

  /// A message a webview pane's page sent.
  record pane-message {
    tab: layout-tab,
    pane: string,
    /// JSON text.
    data: string,
  }

  /// While the layout's `on_message` command runs: the message.
  message: func() -> option<pane-message>;

  /// Where a web page pane went.
  record navigation {
    tab: layout-tab,
    pane: string,
    /// The page's address now.
    url: string,
    /// The page's title, once it has one.
    title: option<string>,
    /// Whether it's still loading.
    loading: bool,
  }

  /// While the layout's `on_navigate` command runs: where a web page pane
  /// went, or that it finished loading or changed its title.
  navigated: func() -> option<navigation>;

  /// Moves a web page pane.
  variant web-action {
    /// To an `https:` or `http:` address.
    go(string),
    back,
    forward,
    reload,
    stop,
  }

  /// Moves a web page pane. Returns false if it isn't open.
  navigate-pane: func(tab: layout-tab, pane: string, action: web-action) -> result<bool, api-error>;
}

/// Opening links (1.15): web addresses and file paths the user Ctrl+clicks
/// in the terminal, in the editor's text, and in previews.
///
/// By default Flareite opens web addresses with the system's browser and
/// files in the editor (folders in the system's file manager). The
/// manifest's `[[link_handlers]]` declare the links an extension opens
/// instead, each with its command; while it runs, `opening` names the
/// link. The user's settings choose between handlers (and Flareite's own
/// way), and Ctrl+Shift+click asks.
interface links {
  use types.{api-error};

  enum link-kind {
    /// A web address: `https:`, `http:`, or `mailto:`.
    web,
    /// A file or folder: an absolute path.
    file,
  }

  record link {
    kind: link-kind,
    /// The address, or the path.
    target: string,
    /// For a file: the line the link names (`main.rs:12`), from 0.
    line: option<u32>,
    /// For a file: the column the link names (`main.rs:12:5`), from 0, in
    /// characters.
    column: option<u32>,
  }

  /// While a link handler's command runs: the link to open; `none`
  /// otherwise.
  opening: func() -> option<link>;

  /// Opens the link a handler's command was run for Flareite's own way
  /// (the system's browser, or the editor), e.g. for an address the
  /// handler doesn't take after all. Only while the command runs.
  open-default: func() -> result<_, api-error>;

  /// Opens a web address (`https:`, `http:`, or `mailto:`) with the
  /// system's browser, as a "Open in Browser" button does. At most one a
  /// second.
  open-in-browser: func(url: string) -> result<_, api-error>;
}

/// Comparing files with their originals as they're edited (1.9): the
/// editor marks changed lines beside the text, shows a change's original
/// lines on request, and can revert changes, or apply them to the original
/// (staging them, for Git).
///
/// The manifest's `[quick_diff]` names the command that finds a file's
/// original (`original`), and optionally the command that applies changes to
/// it (`apply`, with `apply_title`, such as "Stage"). An original is an
/// address the extension provides (see `documents`); the editor reads it, and
/// reads it again when the extension says it changed.
interface quick-diff {
  use types.{api-error};

  /// The file (an absolute path) the running `original` command was run
  /// for; `none` otherwise.
  requested-file: func() -> option<string>;

  /// Answers the request: the address of the file's original, or `none`
  /// when it has none (a file Git doesn't track), when nothing is marked.
  set-original: func(path: string, uri: option<string>) -> result<_, api-error>;

  /// An original with changes made to it.
  record applied {
    /// The original's address.
    uri: string,
    /// Its text with the changes made (at most 32 MiB).
    text: string,
  }

  /// While the `apply` command runs: what to make the original.
  to-apply: func() -> option<applied>;

  /// Files' originals may be different ones now (a file became tracked, say):
  /// the editor asks again for these open files', or for all when the list
  /// is empty.
  originals-changed: func(paths: list<string>) -> result<_, api-error>;

  /// Applies the changes the selections in the active editor touch to its
  /// file's original, as if the user chose to: for a command such as "Stage
  /// Selected Ranges".
  apply-selected-ranges: func() -> result<_, api-error>;
}

/// Running one of the extension's commands later (1.10), as for fetching
/// in the background every few minutes.
interface timers {
  use types.{api-error};

  /// Runs `command` (one of the extension's own) once, after `delay-ms`
  /// (1 second to 1 day). Returns the timer's id. At most 16 wait at once;
  /// they're dropped when the extension stops.
  set-timer: func(delay-ms: u32, command: string) -> result<u64, api-error>;

  /// Cancels a timer. Returns false if it had run or been cancelled.
  clear-timer: func(id: u64) -> bool;

  /// The timer the running command was run for; `none` otherwise.
  fired: func() -> option<u64>;
}

/// Schemas (1.16), and documents for them (1.18).
///
/// Flareite checks documents against the schemas that apply to them, and
/// says what the schemas allow and describe at a place in them. It knows no
/// configuration language itself: the extension of each language parses its
/// documents into trees of values (`set-document`), which Flareite checks,
/// and writes what the schemas say in its language's syntax, for completion
/// and hover (`properties`, `values`, `describe`, with
/// `language-features`). Schemas apply to documents of every language an
/// extension parses.
///
/// The manifest's `[[schemas]]` declare schemas in the extension's folder
/// or on the web. `set-schema` provides schemas the extension makes as it
/// runs, such as one for a project's own configuration. They last until
/// the extension stops.
interface schemas {
  use types.{api-error, document-id, severity};

  enum schema-format {
    /// A TOML Schema (`.tosd`, https://tomlschema.org). It checks a
    /// document as TOML values, which have no null.
    toml-schema,
    /// A JSON Schema. It checks a document as the JSON it stands for, with
    /// dates and times as strings.
    json-schema,
  }

  record schema {
    /// The extension's name for it: 1 to 64 letters, digits, '-', '_', or
    /// '.'. Documents can name it as
    /// `flareite://extensions/<extension id>/schemas/<id>`.
    id: string,
    /// The files it's for: name patterns (`*.myconf.toml`), or ends of
    /// paths with '/' (`.vscode/settings.json`); 1 to 50.
    files: list<string>,
    format: schema-format,
    /// The schema (at most 4 MiB). A JSON Schema may reference others on
    /// the web, which Flareite downloads.
    content: string,
  }

  /// Adds a schema, or replaces the extension's schema of the same id.
  /// Fails with `invalid-argument` if the schema can't be loaded (with
  /// why), and `too-large` past 32 schemas (counting the manifest's).
  set-schema: func(schema: schema) -> result<_, api-error>;

  /// Removes one of the extension's schemas. Returns false if it had none
  /// of that id.
  remove-schema: func(id: string) -> bool;

  /// Byte offsets in a document's text, from `start` up to (not including)
  /// `end`. (1.18)
  record span {
    start: u32,
    end: u32,
  }

  /// A scalar value, typed as TOML's are. (1.18)
  variant scalar {
    null,
    boolean(bool),
    integer(s64),
    float(f64),
    %string(string),
    /// A TOML date, time, or both, as written (`1979-05-27T07:32:00Z`,
    /// `1979-05-27`, `07:32:00`).
    datetime(string),
  }

  /// (1.18)
  variant node-kind {
    /// A table, object, or mapping: the nodes naming it as their parent,
    /// in order, are its entries.
    table,
    /// An array or sequence: the nodes naming it as their parent, in
    /// order, are its items.
    array,
    /// A scalar, with its value; `none` for one still being typed, whose
    /// value can't be told yet.
    scalar(option<scalar>),
  }

  /// A value in a document. (1.18)
  record node {
    /// The table or array it's in: the index of a node before it in the
    /// list. `none` for the root of a part.
    parent: option<u32>,
    /// Its key, in a table; `none` in an array, or for a root.
    key: option<string>,
    /// Where its key is written, if it is: problems with the entry are
    /// marked there.
    key-span: option<span>,
    /// Where the value is written. Empty when it isn't written out on its
    /// own (a TOML table made by a dotted key).
    span: span,
    kind: node-kind,
  }

  /// A problem the parser found: a syntax error, or a key written twice.
  /// (1.18)
  record parse-problem {
    span: span,
    severity: severity,
    message: string,
  }

  /// A document as the extension parsed it. (1.18)
  record document-tree {
    /// Its values, each after the table or array it's in. Each node without
    /// a parent is the root of a part: a document of its own, of which
    /// files usually have one (a YAML stream has one for each `---`).
    nodes: list<node>,
    /// Where each part is written, one for each root, in order. Together
    /// they should cover the text, so the cursor is always in one.
    parts: list<span>,
    /// The schema the document names for itself (a `$schema` key, or a
    /// comment such as TOML's `#:schema`), as written: an address, or a
    /// path relative to the document's file. It alone applies.
    named-schema: option<string>,
    /// If one is an error, the problems are reported alone: the document
    /// isn't checked against schemas.
    problems: list<parse-problem>,
  }

  /// Sets what an open document holds, as the extension parsed it at
  /// `version` (1.18). Flareite checks it against the schemas that apply,
  /// once typing pauses, and shows the problems (labeled with the
  /// extension's name for the parser's), until the next tree or
  /// `clear-document`; `properties`, `values`, and `describe` read it.
  /// Set a tree whenever the document changes, from what parses: a
  /// document being typed rarely parses whole. Needs `documents-read`.
  /// Fails with `invalid-argument` for a node whose parent isn't a table
  /// or array before it, an entry of a table without a key, a span that
  /// ends before it starts, or roots and parts that don't pair up;
  /// `too-large` past 1,000,000 nodes or 10,000 problems. Problems at
  /// spans past the text aren't shown.
  set-document: func(id: document-id, version: u64, tree: document-tree) -> result<_, api-error>;

  /// Forgets a document's tree, and its problems. (1.18)
  clear-document: func(id: document-id);

  /// A step in a path to a value: a table's key or an array's index.
  /// (1.18)
  variant segment {
    key(string),
    index(u32),
  }

  /// How a value is written, for completing its key. (1.18)
  enum shape {
    /// A string, number, boolean, date, or a value of several kinds.
    value,
    table,
    /// An array of tables (`[[name]]` in TOML).
    array-of-tables,
    array,
  }

  /// A key a table may have. (1.18)
  record property {
    name: string,
    /// Markdown.
    description: option<string>,
    /// The kind of value, as a schema names it (`string`,
    /// `integer | boolean`).
    kind: option<string>,
    shape: shape,
    required: bool,
    deprecated: bool,
  }

  /// A value a schema allows or suggests. (1.18)
  record value-choice {
    /// The value, as JSON.
    value: string,
    /// Markdown.
    description: option<string>,
    /// The schema's default.
    default: bool,
  }

  /// What the schemas say about a value. (1.18)
  record value-info {
    title: option<string>,
    /// Markdown.
    description: option<string>,
    kind: option<string>,
    /// As JSON.
    default: option<string>,
    /// The only values allowed, if the schemas list them, as JSON.
    allowed: list<string>,
    /// `some` when it's deprecated, with why if the schema says (or empty).
    deprecated: option<string>,
    /// Other constraints, in words ("At least 1", "Matches `^[a-z]+$`").
    constraints: list<string>,
    /// The names of the schemas that say it.
    schemas: list<string>,
  }

  /// The keys the table at `path` may have, in part `part` of a document
  /// the extension set a tree for, by every schema that applies to it
  /// (1.18). Schemas that pick a branch by what the document holds (a JSON
  /// Schema's `if`) are followed through the tree. Fails with
  /// `invalid-argument` for a document without a tree. Needs
  /// `documents-read`.
  properties: func(id: document-id, part: u32, path: list<segment>) -> result<list<property>, api-error>;

  /// The values the schemas allow or suggest at `path` (1.18): those they
  /// list, booleans, defaults, and what's installed, for Flareite's
  /// settings that name it.
  values: func(id: document-id, part: u32, path: list<segment>) -> result<list<value-choice>, api-error>;

  /// What the schemas say about the value at `path` (1.18); `none` if
  /// nothing.
  describe: func(id: document-id, part: u32, path: list<segment>) -> result<option<value-info>, api-error>;
}

/// Completion and hover from an extension's code (1.18), for documents of
/// the languages the manifest's `[[completion_providers]]` and
/// `[[hover_providers]]` name. Flareite runs a provider's command when the
/// user asks for completions or hovers in such a document, and shows what
/// it answers with a language server's. While the command runs,
/// `completing` or `hovering` says what it's asked; it answers with
/// `set-completions` or `set-hover`, once. The extension has been told of
/// every change to the document up to the request's version. Needs
/// `documents-read`.
interface language-features {
  use types.{api-error, document-id, position};

  record completion-request {
    document: document-id,
    version: u64,
    position: position,
    /// The character whose typing asked, if one did: one of the provider's
    /// `trigger_characters`.
    trigger: option<string>,
  }

  /// What a completion is, for its icon.
  enum completion-kind {
    text,
    method,
    function,
    %constructor,
    field,
    variable,
    class,
    %interface,
    module,
    property,
    %enum,
    keyword,
    snippet,
    file,
    folder,
    enum-member,
    constant,
    struct,
    operator,
    type-parameter,
  }

  record completion-item {
    /// What the list shows: at most 200 characters.
    label: string,
    kind: completion-kind,
    /// Shown beside the label, such as a type: at most 200 characters.
    detail: option<string>,
    /// Where the inserted text starts: on the request's line, at or before
    /// its position. What's there up to the position is replaced.
    start: position,
    /// The text inserted, at most 4 KiB. It may span lines.
    insert: string,
    /// Matched against what's typed from `start`; the label if `none`.
    filter: option<string>,
    /// Sorted by, among items that match as well; the label if `none`.
    sort: option<string>,
    deprecated: bool,
  }

  /// While a completion provider's command runs: what it's asked;
  /// `none` otherwise.
  completing: func() -> option<completion-request>;

  /// Answers the completion request, with at most 1,000 items. Fails with
  /// `invalid-argument` outside a provider's command, or for an item
  /// starting elsewhere than on the request's line before its position.
  set-completions: func(items: list<completion-item>) -> result<_, api-error>;

  record hover-request {
    document: document-id,
    version: u64,
    position: position,
  }

  /// While a hover provider's command runs: what it's asked; `none`
  /// otherwise.
  hovering: func() -> option<hover-request>;

  /// Answers the hover request with Markdown (at most 64 KiB), shown in
  /// the hover card. Fails with `invalid-argument` outside a provider's
  /// command.
  set-hover: func(markdown: string) -> result<_, api-error>;

  /// What an auto-insert provider is asked once one of its trigger
  /// characters is typed. (1.19)
  record auto-insert-request {
    document: document-id,
    version: u64,
    /// The cursor, just after the typed character.
    position: position,
    /// The character typed: one of the provider's `trigger_characters`.
    /// Enter is `"\n"`, with the position on the new line, after its
    /// indentation.
    trigger: string,
    /// One level of indentation as the editor inserts it: spaces, or a tab.
    indent: string,
  }

  /// While an auto-insert provider's command runs: what it's asked; `none`
  /// otherwise. (1.19)
  inserting: func() -> option<auto-insert-request>;

  /// Answers the auto-insert request: `text` (at most 4 KiB) is inserted at
  /// the request's position, leaving the cursor `cursor` bytes into it, if
  /// the document is still at the request's version with a single cursor
  /// there. Not answering inserts nothing. Fails with `invalid-argument`
  /// outside a provider's command, or if `cursor` isn't a character
  /// boundary of `text`. (1.19)
  set-insert: func(text: string, cursor: u32) -> result<_, api-error>;
}

/// The language servers the extension declares (1.16), which Flareite
/// runs: their arguments and settings, as the extension's settings or the
/// open folder call for. Needs the `language_servers` permission. The
/// manifest's `args` and `settings` apply until these change them, and
/// last until the extension stops; the user's `[lsp.servers.<name>]`
/// settings go over both.
///
/// A server declared by an extension with code starts after the extension
/// has activated, if it activates for one of the server's languages (or
/// on startup), so `activate` can configure it first.
interface language-servers {
  use types.{api-error};

  /// Replaces the arguments of one of its servers (by name). An argument
  /// may name a file on the web as `${download:https://...}`: Flareite
  /// downloads it, keeps it (getting it again once it's a day old), and
  /// puts its path in its place; an argument whose file can't be had is
  /// left out. Running instances of the server restart if the arguments
  /// changed. At most 32 arguments of 1,000 characters each.
  set-arguments: func(server: string, args: list<string>) -> result<_, api-error>;

  /// Replaces the settings of one of its servers: a JSON object, which
  /// answers the server's `workspace/configuration` requests (dotted keys,
  /// like `"a.b"`, are nested objects). Running instances are told with
  /// `workspace/didChangeConfiguration`. At most 256 KiB.
  set-settings: func(server: string, settings: string) -> result<_, api-error>;

  /// Restarts the running instances of one of its servers, as a setting
  /// it reads only at startup needs.
  restart: func(server: string) -> result<_, api-error>;
}

/// Files from the web, such as data an extension builds a schema from.
/// (1.17) Needs the `network` permission: without it, `download` fails
/// with `invalid-argument`.
///
/// Flareite downloads a file once and keeps it, sharing the copy with
/// language servers' `${download:...}` arguments. A kept copy is used at
/// once; once it's a day old, it's downloaded again in the background, and
/// later requests get the new one.
interface downloads {
  use types.{api-error};

  /// Gets the file at an `https://` address, and returns at once. When it's
  /// had (or can't be), `command` (one of the extension's own) runs,
  /// during which `downloaded` returns it. Files are at most 32 MiB.
  download: func(address: string, command: string) -> result<u64, api-error>;

  record downloaded-file {
    /// What `download` returned.
    request: u64,
    address: string,
    /// The file's content, or why it couldn't be had.
    outcome: result<list<u8>, string>,
  }

  /// The file the running command was run for; `none` otherwise.
  downloaded: func() -> option<downloaded-file>;
}

/// Secrets, such as API keys and tokens, kept in the system's credential
/// store (Windows Credential Manager, the macOS Keychain, or the Secret
/// Service on Linux) rather than in Flareite's files. (1.17) Needs no
/// permission: an extension sees only its own. Users can clear an
/// extension's secrets with its storage in the Extensions view.
interface secrets {
  variant secret-error {
    /// A bad key or value; why.
    invalid-argument(string),
    /// The request exceeds one of the host's limits.
    too-large(string),
    /// The credential store couldn't be reached or refused; why. On Linux,
    /// this is when no Secret Service (such as GNOME Keyring or KWallet)
    /// runs.
    unavailable(string),
  }

  /// A secret, or `none` if it has none of that key.
  get: func(key: string) -> result<option<string>, secret-error>;

  /// Sets a secret (at most 2 KiB), or removes it (`none`). Keys are 1 to
  /// 200 bytes; an extension has at most 32 secrets.
  set: func(key: string, value: option<string>) -> result<_, secret-error>;

  /// The keys of its secrets, sorted.
  keys: func() -> list<string>;
}

world extension {
  use types.{activation, command-context, document-change, document-id, document-info};

  import host;
  import workbench;
  import files;
  import viewers;
  import webviews;
  import storage;
  import workspace;
  import processes;
  import explorer;
  import views;
  import prompts;
  import documents;
  import quick-diff;
  import timers;
  import layouts;
  import links;
  import schemas;
  import language-features;
  import language-servers;
  import downloads;
  import secrets;

  /// Called once before any other export. An error fails the extension.
  export activate: func(context: activation) -> result<_, string>;

  /// Called before the extension is unloaded.
  export deactivate: func();

  /// Runs one of the commands declared in the manifest.
  export run-command: func(command: string, context: command-context) -> result<_, string>;

  /// A document was opened, or was already open when the extension was
  /// activated. Only sent with the `documents-read` permission, as are the
  /// other document notifications.
  export document-opened: func(document: document-info);

  export document-changed: func(change: document-change);

  export document-closed: func(document: document-id);
}
